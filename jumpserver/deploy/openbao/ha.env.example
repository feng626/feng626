# Copy this file to a protected path on each HAProxy host, fill in its values,
# then run: set -a; . /path/to/openbao-ha.env; set +a; deploy/openbao/start-ha.sh

# Comma-separated real IP/DNS endpoints of the three OpenBao servers.
OPENBAO_HAPROXY_BACKENDS=10.0.0.11:8200,10.0.0.12:8200,10.0.0.13:8200

# HAProxy is started on both proxy hosts. Do not bind it to the VIP: the backup
# host does not own the VIP until a failover occurs.
OPENBAO_HAPROXY_PORT=8200
OPENBAO_HAPROXY_BIND=0.0.0.0

# Keep generated HAProxy and Keepalived configuration outside the source tree.
OPENBAO_HA_RUNTIME_DIR=/opt/jumpserver/config/openbao-ha

# Keepalived/VIP. This file is for the primary proxy host. On the backup, swap
# LOCAL_IP and PEER_IP, change STATE to BACKUP, and use a lower PRIORITY.
OPENBAO_KEEPALIVED_ENABLED=true
OPENBAO_KEEPALIVED_INTERFACE=ens160
OPENBAO_KEEPALIVED_STATE=MASTER
OPENBAO_KEEPALIVED_PRIORITY=150
OPENBAO_KEEPALIVED_ROUTER_ID=51
OPENBAO_KEEPALIVED_LOCAL_IP=10.0.0.21
OPENBAO_KEEPALIVED_PEER_IP=10.0.0.22
OPENBAO_KEEPALIVED_VIP=10.0.0.20/24

# Keepalived PASS authentication is limited to eight alphanumeric characters.
OPENBAO_KEEPALIVED_AUTH_PASS=ChangeMe
